# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# ── Storage (choose one: gcs | s3) ───────────────────────────
STORAGE_PROVIDER=gcs

# Google Cloud Storage (when STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME=vision-rag-bucket
GCS_PUBLIC_URL_BASE=https://storage.googleapis.com/vision-rag-bucket
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
S3_BUCKET_NAME=vision-rag-bucket
S3_PUBLIC_URL_BASE=https://vision-rag-bucket.s3.us-east-1.amazonaws.com

# ── Temporal ─────────────────────────────────────────────────
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Vector DB (choose one: pinecone) ─────────────────────────
VECTOR_DB_PROVIDER=pinecone
VECTOR_DB_INDEX_NAME=vision-rag
PINECONE_API_KEY=your-pinecone-api-key

# ── Cohere ───────────────────────────────────────────────────
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBED_MODEL=embed-v4.0

# ── Gemini (Vertex AI) ───────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GEMINI_MODEL=gemini-2.5-pro
